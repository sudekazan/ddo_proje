# Kopyalayın: cp .env.example .env
POSTGRES_USER=dishekimim
POSTGRES_PASSWORD=dishekimim_dev_password
POSTGRES_DB=dishekimim

# En az 32 karakter. Üretimde mutlaka değiştirin.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Veri üretici: aynı SEED + aynı SEED_ANCHOR (YYYY-AA-GG) => aynı veri. Boş anchor = bugün.
SEED=42
SEED_ANCHOR=
SIM_INTERVAL=3s

CLINIC_TZ=Europe/Istanbul
LOG_LEVEL=info
